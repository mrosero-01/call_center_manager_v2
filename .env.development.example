DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_USE_X_FORWARDED_PROTO=False
DJANGO_TRUST_X_FORWARDED_FOR=False
DJANGO_ENABLE_ADMIN=False

DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_TO_FILE=False
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
DJANGO_DATA_UPLOAD_MAX_NUMBER_FIELDS=100

DB_NAME=callcenter_manager
DB_USER=callcenter_app
DB_PASSWORD=replace-with-a-development-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_TEST_NAME=test_callcenter_manager
