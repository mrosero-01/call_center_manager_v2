[validar_horario]
exten => s,1,NoOp(Validando horario PostgreSQL para ${ARG1})
 same => n,Set(CODENAME=${ARG1})
 same => n,Set(ESTADO=${ODBC_CALLCENTER_STATUS(${CODENAME})})
 same => n,GotoIf($["${ESTADO}" = ""]?no_configurado)
 same => n,Set(HABILITADO=${CUT(ESTADO,|,1)})
 same => n,Set(ABIERTO=${CUT(ESTADO,|,2)})
 same => n,Set(AUDIO_CIERRE=${CUT(ESTADO,|,3)})
 same => n,Set(ZONA_HORARIA=${CUT(ESTADO,|,4)})
 same => n,NoOp(CallCenter=${CODENAME} Habilitado=${HABILITADO} Abierto=${ABIERTO} Zona=${ZONA_HORARIA})
 same => n,GotoIf($["${HABILITADO}" != "1"]?cerrado)
 same => n,GotoIf($["${ABIERTO}" = "1"]?abierto:cerrado)
 same => n(no_configurado),NoOp(CallCenter ${CODENAME} no existe en Siptic Manager)
 same => n,Set(AUDIO_CIERRE=vm-goodbye)
 same => n,Goto(cerrado)
 same => n(cerrado),NoOp(CallCenter ${CODENAME} CERRADO)
 same => n,Set(AUDIO_WAV=/var/lib/asterisk/sounds/${AUDIO_CIERRE}.wav)
 same => n,Set(AUDIO_GSM=/var/lib/asterisk/sounds/${AUDIO_CIERRE}.gsm)
 same => n,GotoIf($[${STAT(e,${AUDIO_WAV})} | ${STAT(e,${AUDIO_GSM})}]?audio_configurado:audio_respaldo)
 same => n(audio_configurado),Playback(${AUDIO_CIERRE})
 same => n,Goto(fin_cerrado)
 same => n(audio_respaldo),Playback(vm-goodbye)
 same => n(fin_cerrado),Hangup()
 same => n(abierto),Return()
